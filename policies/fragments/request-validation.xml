<!--
    Fragment: request-validation

    Enforces the allowlist in specs/responses-request.schema.json, plus the
    two rules carrying the most security weight: the model allowlist and
    stateless operation.

    Body handling: this fragment reads the request body, which is unavoidable
    for schema validation and for injecting store=false. It uses
    preserveContent so the body survives for forwarding. "Unbuffered SSE" in
    this repository refers to the RESPONSE stream (see docs/observability.md);
    it is not a claim that the request body is never materialized.

    XML note: inner double quotes appear as &quot; and generics as &lt;T&gt;.
-->
<fragment>
    <!-- Reject anything that is not JSON before attempting to parse it. -->
    <choose>
        <when condition="@(!context.Request.Headers.GetValueOrDefault(&quot;Content-Type&quot;, &quot;&quot;).Contains(&quot;application/json&quot;))">
            <set-variable name="failure-category" value="invalid_request" />
            <set-variable name="rejected-status" value="415" />
            <!-- return-response cancels the pipeline; emit telemetry here. -->
            <!--
                Trace inlined rather than included.

                A policy FRAGMENT cannot contain <include-fragment>, and
                return-response cancels the pipeline so outbound never runs.
                Inlining is the only way this rejection emits telemetry.

                EVERY value must be non-empty: an empty metadata value makes
                APIM silently drop the fragment at creation time and throw at
                runtime. Absent fields coalesce to "none", which
                specs/telemetry.schema.json documents as the absent marker.

                Field names match policies/fragments/observability.xml exactly
                so the KQL in queries/ works uniformly across rejection and
                success paths.
            -->
            <trace source="mission-apimpossible" severity="information">
                <message>responses.invocation</message>
                <metadata name="schema_version" value="1.0" />
                <metadata name="environment" value="{{map-environment-name}}" />
                <metadata name="model_deployment" value="{{map-approved-deployment}}" />
                <metadata name="operation" value="responses.create" />
                <metadata name="correlation_id" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;correlation-id&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;none&quot; : v;
                }" />
                <metadata name="gateway_request_id" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;gateway-request-id&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;none&quot; : v;
                }" />
                <metadata name="foundry_request_id" value="none" />
                <metadata name="tenant_id" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;claim-tid&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;none&quot; : v;
                }" />
                <metadata name="object_id" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;claim-oid&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;none&quot; : v;
                }" />
                <metadata name="client_app_id" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;claim-azp&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;none&quot; : v;
                }" />
                <metadata name="status_code" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;rejected-status&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;0&quot; : v;
                }" />
                <metadata name="streaming" value="@(context.Variables.GetValueOrDefault&lt;bool&gt;(&quot;is-streaming&quot;, false).ToString())" />
                <metadata name="failure_category" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;failure-category&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;none&quot; : v;
                }" />
                <metadata name="apim_duration_ms" value="@(context.Elapsed.TotalMilliseconds.ToString(&quot;F0&quot;))" />
                <metadata name="usage_source" value="unavailable" />
            </trace>
            <return-response>
                <set-status code="415" reason="Unsupported Media Type" />
                <set-header name="Content-Type" exists-action="override">
                    <value>application/json</value>
                </set-header>
                <set-header name="x-correlation-id" exists-action="override">
                    <value>@((string)context.Variables["correlation-id"])</value>
                </set-header>
                <set-body>@{
                    var payload = new JObject(
                        new JProperty("error", new JObject(
                            new JProperty("code", "invalid_request"),
                            new JProperty("message", "Content-Type must be application/json."),
                            new JProperty("correlation_id", (string)context.Variables["correlation-id"])
                        ))
                    );
                    return payload.ToString(Newtonsoft.Json.Formatting.None);
                }</set-body>
            </return-response>
        </when>
    </choose>

    <!-- Parse once; keep the body intact for forwarding. -->
    <set-variable name="request-json" value="@(context.Request.Body.As&lt;JObject&gt;(preserveContent: true))" />

    <!--
        Model allowlist.

        The schema constrains the SHAPE of `model`; this constrains the VALUE.
        A caller cannot reach any deployment other than the approved one, even
        if another deployment exists on the account.
    -->
    <set-variable name="requested-model" value="@{
        var body = (JObject)context.Variables[&quot;request-json&quot;];
        var model = body[&quot;model&quot;];
        return model == null ? &quot;&quot; : model.ToString();
    }" />

    <choose>
        <when condition="@((string)context.Variables[&quot;requested-model&quot;] != &quot;{{map-approved-deployment}}&quot;)">
            <set-variable name="failure-category" value="unapproved_model" />
            <set-variable name="rejected-status" value="400" />
            <!--
                Trace inlined rather than included.

                A policy FRAGMENT cannot contain <include-fragment>, and
                return-response cancels the pipeline so outbound never runs.
                Inlining is the only way this rejection emits telemetry.

                EVERY value must be non-empty: an empty metadata value makes
                APIM silently drop the fragment at creation time and throw at
                runtime. Absent fields coalesce to "none", which
                specs/telemetry.schema.json documents as the absent marker.

                Field names match policies/fragments/observability.xml exactly
                so the KQL in queries/ works uniformly across rejection and
                success paths.
            -->
            <trace source="mission-apimpossible" severity="information">
                <message>responses.invocation</message>
                <metadata name="schema_version" value="1.0" />
                <metadata name="environment" value="{{map-environment-name}}" />
                <metadata name="model_deployment" value="{{map-approved-deployment}}" />
                <metadata name="operation" value="responses.create" />
                <metadata name="correlation_id" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;correlation-id&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;none&quot; : v;
                }" />
                <metadata name="gateway_request_id" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;gateway-request-id&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;none&quot; : v;
                }" />
                <metadata name="foundry_request_id" value="none" />
                <metadata name="tenant_id" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;claim-tid&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;none&quot; : v;
                }" />
                <metadata name="object_id" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;claim-oid&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;none&quot; : v;
                }" />
                <metadata name="client_app_id" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;claim-azp&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;none&quot; : v;
                }" />
                <metadata name="status_code" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;rejected-status&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;0&quot; : v;
                }" />
                <metadata name="streaming" value="@(context.Variables.GetValueOrDefault&lt;bool&gt;(&quot;is-streaming&quot;, false).ToString())" />
                <metadata name="failure_category" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;failure-category&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;none&quot; : v;
                }" />
                <metadata name="apim_duration_ms" value="@(context.Elapsed.TotalMilliseconds.ToString(&quot;F0&quot;))" />
                <metadata name="usage_source" value="unavailable" />
            </trace>
            <return-response>
                <set-status code="400" reason="Bad Request" />
                <set-header name="Content-Type" exists-action="override">
                    <value>application/json</value>
                </set-header>
                <set-header name="x-correlation-id" exists-action="override">
                    <value>@((string)context.Variables["correlation-id"])</value>
                </set-header>
                <set-body>@{
                    var payload = new JObject(
                        new JProperty("error", new JObject(
                            new JProperty("code", "unapproved_model"),
                            new JProperty("message", "The requested model is not approved for this gateway."),
                            new JProperty("correlation_id", (string)context.Variables["correlation-id"])
                        ))
                    );
                    return payload.ToString(Newtonsoft.Json.Formatting.None);
                }</set-body>
            </return-response>
        </when>
    </choose>

    <!--
        Stateless enforcement.

        Explicit store:true is REJECTED rather than rewritten. Silently
        flipping a developer's stated intent would hide a security-relevant
        decision from them - they would believe their source was persisted
        when it was not, or stop considering the question at all.

        The schema already pins store to the literal boolean false; this
        catches it defensively and returns a specific, actionable error code
        rather than a generic schema violation.
    -->
    <set-variable name="store-violation" value="@{
        var body = (JObject)context.Variables[&quot;request-json&quot;];
        var store = body[&quot;store&quot;];
        if (store == null || store.Type == JTokenType.Null) { return false; }
        if (store.Type != JTokenType.Boolean) { return true; }
        return store.Value&lt;bool&gt;();
    }" />

    <choose>
        <when condition="@((bool)context.Variables[&quot;store-violation&quot;])">
            <set-variable name="failure-category" value="store_not_permitted" />
            <set-variable name="rejected-status" value="400" />
            <!--
                Trace inlined rather than included.

                A policy FRAGMENT cannot contain <include-fragment>, and
                return-response cancels the pipeline so outbound never runs.
                Inlining is the only way this rejection emits telemetry.

                EVERY value must be non-empty: an empty metadata value makes
                APIM silently drop the fragment at creation time and throw at
                runtime. Absent fields coalesce to "none", which
                specs/telemetry.schema.json documents as the absent marker.

                Field names match policies/fragments/observability.xml exactly
                so the KQL in queries/ works uniformly across rejection and
                success paths.
            -->
            <trace source="mission-apimpossible" severity="information">
                <message>responses.invocation</message>
                <metadata name="schema_version" value="1.0" />
                <metadata name="environment" value="{{map-environment-name}}" />
                <metadata name="model_deployment" value="{{map-approved-deployment}}" />
                <metadata name="operation" value="responses.create" />
                <metadata name="correlation_id" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;correlation-id&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;none&quot; : v;
                }" />
                <metadata name="gateway_request_id" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;gateway-request-id&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;none&quot; : v;
                }" />
                <metadata name="foundry_request_id" value="none" />
                <metadata name="tenant_id" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;claim-tid&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;none&quot; : v;
                }" />
                <metadata name="object_id" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;claim-oid&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;none&quot; : v;
                }" />
                <metadata name="client_app_id" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;claim-azp&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;none&quot; : v;
                }" />
                <metadata name="status_code" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;rejected-status&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;0&quot; : v;
                }" />
                <metadata name="streaming" value="@(context.Variables.GetValueOrDefault&lt;bool&gt;(&quot;is-streaming&quot;, false).ToString())" />
                <metadata name="failure_category" value="@{
                    var v = context.Variables.GetValueOrDefault&lt;string&gt;(&quot;failure-category&quot;, &quot;&quot;);
                    return string.IsNullOrEmpty(v) ? &quot;none&quot; : v;
                }" />
                <metadata name="apim_duration_ms" value="@(context.Elapsed.TotalMilliseconds.ToString(&quot;F0&quot;))" />
                <metadata name="usage_source" value="unavailable" />
            </trace>
            <return-response>
                <set-status code="400" reason="Bad Request" />
                <set-header name="Content-Type" exists-action="override">
                    <value>application/json</value>
                </set-header>
                <set-header name="x-correlation-id" exists-action="override">
                    <value>@((string)context.Variables["correlation-id"])</value>
                </set-header>
                <set-body>@{
                    var payload = new JObject(
                        new JProperty("error", new JObject(
                            new JProperty("code", "store_not_permitted"),
                            new JProperty("message", "This gateway enforces stateless operation. Omit 'store' or set it to false."),
                            new JProperty("correlation_id", (string)context.Variables["correlation-id"])
                        ))
                    );
                    return payload.ToString(Newtonsoft.Json.Formatting.None);
                }</set-body>
            </return-response>
        </when>
    </choose>

    <!--
        Record whether this is a streaming request. The observability fragment
        needs it, and the response body cannot be inspected later without
        breaking SSE.
    -->
    <set-variable name="is-streaming" value="@{
        var body = (JObject)context.Variables[&quot;request-json&quot;];
        var stream = body[&quot;stream&quot;];
        if (stream == null || stream.Type != JTokenType.Boolean) { return false; }
        return stream.Value&lt;bool&gt;();
    }" />

    <!--
        Inject store:false when the caller omitted it, so statelessness never
        depends on client behavior.
    -->
    <set-body>@{
        var body = (JObject)context.Variables["request-json"];
        body["store"] = false;
        return body.ToString(Newtonsoft.Json.Formatting.None);
    }</set-body>
</fragment>
